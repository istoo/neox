{
  "name": "@neolix/desktop",
  "version": "0.17.0-beta.1",
  "private": true,
  "description": "Neox desktop app (Electron wrapper)",
  "homepage": "https://github.com/istoo/neox",
  "license": "Apache-2.0",
  "author": {
    "name": "Mohamed Boudra",
    "email": "hello@moboudra.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/istoo/neox.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "npm --prefix ../.. run build:server:clean && npm --prefix ../.. run build:daemon-web-app && npm run build:main && npm run build:desktop-web && electron-builder --config electron-builder.yml",
    "build:main": "tsc -p tsconfig.json",
    "build:desktop-web": "bun run --cwd ../desktop-web/apps/bridge build:bundle && bun run --cwd ../desktop-web/apps/web build",
    "capture-harness": "npm run build:main && ./capture-harness/run.sh",
    "dev": "./scripts/dev.sh",
    "dev:win": "powershell ./scripts/dev.ps1",
    "verify:electron-cdp": "node ./scripts/verify-electron-cdp.mjs",
    "test": "install-electron && vitest run --exclude \"e2e/**\"",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test:e2e:lifecycle": "npm run build:main && node ./e2e/daemon-lifecycle.e2e.mjs",
    "test:e2e:window-startup": "npm run build:main && node ./e2e/window-startup.e2e.mjs"
  },
  "dependencies": {
    "@neolix/cli": "*",
    "@neolix/client": "*",
    "@neolix/protocol": "*",
    "@neolix/server": "*",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "ws": "^8.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "24.6.0",
    "@types/ws": "^8.5.14",
    "electron": "44.2.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.6",
    "wait-on": "8.0.5"
  },
  "desktopName": "Neox.desktop"
}
