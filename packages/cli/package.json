{
  "name": "@neolix/cli",
  "version": "0.16.4",
  "description": "Neox CLI - control your AI coding agents from the command line",
  "license": "Apache-2.0",
  "bin": {
    "neolix": "bin/neolix",
    "neox": "bin/neolix"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsgo --noEmit",
    "test": "npm run test:unit && npm run test:local",
    "test:unit": "vitest run src",
    "test:local": "tsx tests/run-all.ts",
    "test:e2e": "npm run test:local",
    "test:e2e:lifecycle": "npx tsx tests/e2e/agent-lifecycle.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@neolix/client": "0.16.4",
    "@neolix/protocol": "0.16.4",
    "@neolix/server": "0.16.4",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ink": "^7.1.1",
    "mime-types": "^2.1.35",
    "react": "^19.2.3",
    "tree-kill": "^1.2.2",
    "ws": "^8.14.2",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.5.8",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6",
    "zx": "^8.8.5"
  },
  "//": "neox is the command; neolix stays as an alias."
}
