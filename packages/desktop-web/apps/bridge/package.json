{
  "name": "@neolix/synara-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build:bundle": "bun build src/main.ts --target=node --format=esm --outfile dist/main.js",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@synara/contracts": "workspace:*",
    "@synara/shared": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
